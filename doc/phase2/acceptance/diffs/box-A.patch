+import type { Plugin, PluginContext } from '../../core/public/Plugin.js';
+import { BoxProvider } from './BoxProvider.js';
+import { BoxFillHandler } from './BoxFillHandler.js';
+import { BoxLabelHandler } from './BoxLabelHandler.js';
+import { BoxTypeDecorator } from './BoxTypeDecorator.js';
+
+export default class BoxPlugin implements Plugin {
+  public activate(context: PluginContext): void {
+    context.registerShape(new BoxProvider());
+    context.registerAttribute(new BoxFillHandler()); context.registerAttribute(new BoxLabelHandler());
+    context.registerDecorator(new BoxTypeDecorator());
+  }
+}
diff --git a/src/plugins/shape-box/BoxProvider.ts b/src/plugins/shape-box/BoxProvider.ts
new file mode 100644
index 0000000..6af79f1
--- /dev/null
+++ b/src/plugins/shape-box/BoxProvider.ts
@@ -0,0 +1,34 @@
+import type { AttributeValue, ShapeView } from '../../core/public/Shape.js';
+import type { ShapeProvider, ShapeInput, ShapeEncoding, ShapePresentation, ShapeOperation, ShapeFeedback } from '../../core/public/ShapeProvider.js';
+import { ShapeValidation as V } from '../../core/public/ShapeValidation.js';
+import { BoxShape } from './BoxShape.js';
+import { BoxPart } from './BoxPart.js';
+
+export class BoxProvider implements ShapeProvider {
+  public get name(): string { return 'box'; }
+  public get createSyntax(): string { return 'box <id> <x> <y> <w> <h> "label"'; }
+  public create(id: string, parameters: readonly AttributeValue[]): BoxShape {
+    if (parameters.length !== 5) throw new Error(`invalid arguments. usage: create ${this.createSyntax} [in <containerId>]`);
+    const x = V.number(parameters[0]!); const y = V.number(parameters[1]!);
+    const width = V.nonnegative(parameters[2]!, 'width'); const height = V.nonnegative(parameters[3]!, 'height');
+    const text = V.text(parameters[4]!, 'label');
+    return new BoxShape(id, [new BoxPart(`${id}-rect`, 'rect', [['x', x], ['y', y], ['width', width], ['height', height], ['fill', '#4a90d9']]),
+      new BoxPart(`${id}-label`, 'text', [['x', V.finite(x + 20, 'x')], ['y', V.finite(y + 35, 'y')], ['text', text]])]);
+  }
+  public read(input: ShapeInput): BoxShape {
+    if (input.text.trim().length !== 0) throw new Error('invalid svg: unexpected text in g');
+    const styles = input.attributes.filter(([name]) => name !== 'id' && name !== 'data-kind');
+    for (const [name] of styles) if (!['fill', 'stroke', 'stroke-width'].includes(name)) throw new Error(`unsupported svg attribute: ${name}`);
+    return new BoxShape(input.id, input.children, styles);
+  }
+  public write(shape: ShapeView): ShapeEncoding { return { tag: 'g', attributes: [['id', shape.id], ['data-kind', 'box'], ...shape.attributes] }; }
+  public present(shape: ShapeView): ShapePresentation {
+    const styles = shape.attributes.map(([name, value]) => `${name}=${value}`);
+    return { treeTitle: `g#${shape.id}`, treeDetails: styles.join(' '), showDetails: [`children=${shape.children.length}`, ...styles] };
+  }
+  public feedback(operation: ShapeOperation): ShapeFeedback | undefined {
+    if (operation.name !== 'create' || operation.after === undefined) return undefined;
+    const id = operation.after.id;
+    return { message: `box#${id} created (g#${id} + rect#${id}-rect + text#${id}-label)`, undoMessage: `box#${id} deleted` };
+  }
+}
diff --git a/src/plugins/shape-box/BoxShape.ts b/src/plugins/shape-box/BoxShape.ts
new file mode 100644
index 0000000..ed5f92a
--- /dev/null
+++ b/src/plugins/shape-box/BoxShape.ts
@@ -0,0 +1,40 @@
+import type { AttributeValue, ShapeNode, ShapeView } from '../../core/public/Shape.js';
+import { ShapeValidation as V } from '../../core/public/ShapeValidation.js';
+
+export class BoxShape implements ShapeNode {
+  private readonly nodes: readonly ShapeNode[];
+  private readonly styles = new Map<string, AttributeValue>();
+  public constructor(private readonly idValue: string, children: readonly ShapeNode[],
+    styles: readonly (readonly [string, AttributeValue])[] = []) {
+    V.id(idValue); this.nodes = Object.freeze([...children]); this.validateChildren(children);
+    for (const [name, value] of styles) this.set(name, value);
+  }
+  public get id(): string { return this.idValue; }
+  public get type(): string { return 'box'; }
+  public get isContainer(): boolean { return true; }
+  public get children(): readonly ShapeNode[] { return this.nodes; }
+  public get attributes(): readonly (readonly [string, AttributeValue])[] { return Object.freeze([...this.styles].map(entry => Object.freeze(entry))); }
+  public getAttribute(name: string): AttributeValue | undefined { return this.styles.get(name); }
+  public set(name: string, value: AttributeValue): void {
+    if (name === 'fill' || name === 'stroke') this.styles.set(name, V.text(value, name));
+    else if (name === 'stroke-width') this.styles.set(name, V.nonnegative(value, name));
+    else throw new Error(`unknown attribute: ${name}`);
+  }
+  public view(): ShapeView { return Object.freeze({ id: this.id, type: this.type, isContainer: true,
+    attributes: this.attributes, children: Object.freeze(this.nodes.map(node => node.view())) }); }
+  public clone(): BoxShape { return new BoxShape(this.id, this.nodes.map(node => node.clone()), this.attributes); }
+  public withChildren(children: readonly ShapeNode[]): BoxShape { return new BoxShape(this.id, children, this.attributes); }
+  public validateChildren(children: readonly ShapeNode[]): void {
+    for (const [suffix, type] of [['rect', 'rect'], ['label', 'text']]) {
+      if (!children.some(child => child.id === `${this.id}-${suffix}` && child.type === type)) {
+        throw new Error(`invalid box: ${this.id} requires ${type}#${this.id}-${suffix}`);
+      }
+    }
+  }
+  public assertUngroup(): never { throw new Error(`cannot ungroup composite shape: ${this.id}`); }
+  public move(dx: number, dy: number): void { this.apply(child => child.move(dx, dy)); }
+  public scale(factor: number): void { this.apply(child => child.scale(factor)); }
+  private apply(operation: (child: ShapeNode) => void): void {
+    this.nodes.forEach(child => operation(child.clone())); this.nodes.forEach(operation);
+  }
+}
