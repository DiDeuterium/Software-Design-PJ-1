{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PJ1 SVG Tools",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples",
        "${workspaceFolder}/examples/example.svg"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ]
    }
  ]
}
